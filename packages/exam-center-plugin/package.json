{
  "name": "@ff-ai-frontend/exam-center-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./admin": {
      "types": "./src/admin/index.ts",
      "import": "./src/admin/index.ts"
    },
    "./tenant": {
      "types": "./src/tenant/index.ts",
      "import": "./src/tenant/index.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint && eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "oxfmt . --write && oxlint --fix && eslint . --fix",
    "format:check": "oxfmt . --check"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "@ff-ai-frontend/api": "workspace:*",
    "@ff-ai-frontend/components": "workspace:*",
    "@ff-ai-frontend/utils": "workspace:*",
    "@tanstack/react-query": "^5.100.6",
    "antd": "^6.3.7",
    "antd-style": "^4.1.0",
    "dayjs": "^1.11.20",
    "i18next": "^26.0.10",
    "react": "catalog:",
    "react-i18next": "^17.0.7",
    "react-router": "^7.14.2"
  },
  "devDependencies": {
    "@ff-ai-frontend/tooling": "workspace:*",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
